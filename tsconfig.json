{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": [
            "ES2022"
        ],
        "rootDir": "src",
        "outDir": "out",
        "strict": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "types": [
            "node",
            "vscode"
        ]
    },
    "include": [
        "src/**/*",
        "data/**/*"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test"
    ]
}